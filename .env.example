# ---------- Required ----------
# Free key from https://console.groq.com/keys
GROQ_API_KEY=

# ---------- Optional: models ----------
# Main model (scoring, answers, interview kits). Check https://console.groq.com/docs/models for current free models.
GROQ_MODEL=llama-3.3-70b-versatile
# Small, fast model (only used to classify chat messages)
GROQ_FAST_MODEL=llama-3.1-8b-instant

# ---------- Optional: local embeddings (free, run on your machine) ----------
# Default is a very small model (about 25 MB download on first run, then cached in ./data/models).
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_POOLING=mean
# Larger option (untested here, about 600 MB): onnx-community/Qwen3-Embedding-0.6B-ONNX
#   EMBEDDING_MODEL=onnx-community/Qwen3-Embedding-0.6B-ONNX
#   EMBEDDING_POOLING=last_token
#   EMBEDDING_DTYPE=q8
# EMBEDDING_DTYPE=
# EMBEDDING_QUERY_PREFIX=

# ---------- Optional: sending real emails ----------
# Leave SMTP_HOST empty to run in "simulated" mode (emails are logged, not sent).
# Gmail example: create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---------- Optional: defaults shown in emails ----------
COMPANY_NAME=Your Company
HR_NAME=HR Team

# ---------- Optional: server ----------
PORT=3000
# Keep 127.0.0.1 so only this computer can open the app.
HOST=127.0.0.1
# Set both to require a login (HTTP basic auth)
APP_USER=
APP_PASS=
